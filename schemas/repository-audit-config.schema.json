{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/stauntonjr/agentic-repo-auditor/main/schemas/repository-audit-config.schema.json",
  "title": "Agentic Repo Auditor configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1", "1.2"]
    },
    "disabled_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "uniqueItems": true,
      "default": []
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_contract": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^(?!/)(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001F])(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$))(?!.*\\/\\.git(?:/|$))(?!.*\\\\).+\\.(?:json|ya?ml)$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["not_applicable_reason"],
              "properties": {
                "not_applicable_reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?!\\s)(?!.*\\s$)[^\\r\\n]+$"
                }
              }
            }
          ]
        },
        "primary_check": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "source"],
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?!\\s)(?!.*\\s$)[^\\r\\n]+$"
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^(?!/)(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001F])(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$))(?!.*\\/\\.git(?:/|$))(?!.*\\\\).+$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["not_applicable_reason"],
              "properties": {
                "not_applicable_reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?!\\s)(?!.*\\s$)[^\\r\\n]+$"
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.0"}},
        "required": ["schema_version"]
      },
      "then": {"not": {"required": ["evidence"]}}
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "evidence": {"not": {"required": ["primary_check"]}}
        }
      }
    }
  ]
}
